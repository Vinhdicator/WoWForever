package-as: Necrosis

# The addon lives in the Necrosis/ subfolder. The release workflow creates a
# root-level Necrosis.toc symlink so the packager can discover it, and this
# ignore list keeps repo-root scaffolding (CI, lint config) out of the zip.
ignore:
  - Necrosis/.github
  - Necrosis/.luacheckrc
  - Necrosis/stylua.toml
  - Necrosis/wow_api_globals.lua
  - Necrosis/Necrosis.code-workspace
  - Necrosis/.pkgmeta
